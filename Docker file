# Use official Node image
FROM node:20-alpine

# Create app folder
WORKDIR /app

# Copy package files first (for caching)
COPY package*.json ./

# Install deps
RUN npm ci

# Copy rest of code
COPY . .

# Build (optional if you have build step)
RUN npm run build --if-present

# Expose port (change if your app uses different)
EXPOSE 3000

# Start app
CMD ["npm", "start"]
